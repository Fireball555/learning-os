# Copy to .env (never commit .env)
# Supabase -> Connect -> "Session pooler". Copy the host EXACTLY (it may be aws-0-... or aws-1-...).
# URL-encode special characters in passwords (@ -> %40, # -> %23, / -> %2F, ? -> %3F, % -> %25).
ADMIN_DATABASE_URL=postgresql://postgres.YOURREF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Same host/port, user learner_ro.YOURREF, the password you set in db/03_app_and_roles.sql
LEARNER_DATABASE_URL=postgresql://learner_ro.YOURREF:LEARNER_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
ADMIN_TOKEN=pick-a-long-random-string
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
# Fallback chain when a model is rate-limited (same for both arms). Check with: python scripts/check_models.py
GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.1-8b-instant
# Optional: ember (default) | terminal | paper | blueprint | brutalist | studio — set at BUILD time: VITE_THEME=paper npm run build
